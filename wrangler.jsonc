{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ninetyfour-landing",
  "compatibility_date": "2026-08-29",
  "main": "./worker.js",
  "vars": {
    "BREVO_TEMP_LIST_ID": "4"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
